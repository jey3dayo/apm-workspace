  "cards": [
    {
      "dot": "emerald",
      "title": "管理レーン (通常経路)",
      "items": [
        "catalog は編集後 push し install:catalog で apm.yml に登録",
        "外部 skill は apm.yml に宣言し apm.lock.yaml で解決を固定",
        "mise run deploy が check → apply → doctor を一括実行"
      ]
    },
    {
      "dot": "amber",
      "title": "レーン選択の基準",
      "items": [
        "グローバル個人用は catalog、選択 repo 用は optional-skills",
        "機材ローカルは private-skills（deploy で catalog と同時同期）、workspace 専用は .apm/skills",
        "managed lane で package / deploy できない upstream だけ manual へ"
      ]
    },
    {
      "dot": "rose",
      "title": "禁止・注意",
      "items": [
        "apm_modules/ と ~/.claude ~/.codex ~/.agents は cache / 配布先。手編集せず再生成",
        "upgrade は upstream 更新を受け入れる。通常 rollout は deploy",
        "外部依存の追加・削除は docs/package-decisions.md に記録"
      ]
    }
  ]
}
