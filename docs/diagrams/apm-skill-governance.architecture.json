    "views": [
      {
        "id": "managed-lane",
        "label": "管理レーン (catalog + 外部)",
        "focus": [
          "catalog",
          "upstream",
          "manifest",
          "deploy",
          "claude_home",
          "codex_home"
        ],
        "note": "catalog と外部 upstream は apm.yml / apm.lock.yaml を経由して deploy で配布される。"
      },
      {
        "id": "local-lanes",
        "label": "ローカル系レーン",
        "focus": [
          "private",
          "deploy",
          "wsonly",
          "bridges",
          "codex_home",
          "claude_home"
        ],
        "note": "private は deploy の apply 段で catalog と同時に同期される。workspace-only は bridge symlink。"
      },
      {
        "id": "repo-scoped",
        "label": "repo 限定 / 手動レーン",
        "focus": [
          "optional",
          "consumer_repo",
          "manual",
          "deploy"
        ],
        "note": "optional-skills は利用側 repo が直接 ref を入れる。manual は managed lane が使えない時だけ。"
      }
    ]
  },
