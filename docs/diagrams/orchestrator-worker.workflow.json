  "cards": [
    {
      "dot": "rose",
      "title": "役割判定・委譲・受入の境界",
      "items": [
        "task/handoff: envelope・model不整合→BLOCKED",
        "軽微→Steward、Sonnet/Luna→Architect、Opus/Architect→Orchestrator",
        "非委譲: 権限/認証/秘密/破壊/production。DONE→別Reviewer→diff + DoD→依頼元"
      ]
    },
    {
      "dot": "violet",
      "title": "モデル帯と役・昇格",
      "items": [
        "低コスト帯: sonnet / gpt-5.6-luna xhigh（既定）→max（第1昇格）",
        "バランス帯: gpt-5.6-terra（既知能力崖/Luna max固定で不足実証、長文脈直行、多読Review+high）",
        "高性能帯: Fable / gpt-5.6-sol / Opus（Architect/Reviewer、sol既定、Fable→Opus、sol固有直行、sonnet→opus）"
      ]
    }
